
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

int pin1 = A0;
int pin2 = A1;

LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {
  pinMode(pin1, INPUT);
  pinMode(pin2, INPUT);

  lcd.init();
  lcd.backlight();
}

void loop() {
  int value1 = analogRead(pin1);
  int value2 = analogRead(pin2);

  int difference = value1 - value2;
  float voltage = difference * 5.0 / 1023.0;

  lcd.setCursor(0, 0);
  lcd.print("BATTERY VOLTAGE");

  lcd.setCursor(0, 1);
  lcd.print(voltage, 2);
  lcd.print(" Voltage: ");

  delay(500);
}
